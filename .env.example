# LLM API Keys (copy to .env.local and fill in)
K2_API_KEY=your-k2-api-key-here

# Optional: override which model to use
# MODEL_NAME=k2-think-v2

# Optional: enable swarm mode (two-phase NPC rounds)
# SWARM=true

# Optional: allowed CORS origins (comma-separated for multiple)
# ALLOWED_ORIGINS=http://localhost:3000

# Frontend — set at build time for Next.js
# NEXT_PUBLIC_API_URL=http://localhost:8000
